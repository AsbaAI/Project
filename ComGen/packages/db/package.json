{
  "name": "@comgen/db",
  "version": "0.1.0",
  "private": true,
  "description": "Schéma Prisma de ComGen et contexte d'accès aux données cloisonné par organisation.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/test/base-de-test.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "node --experimental-strip-types prisma/seed.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@comgen/core": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "jszip": "^3.10.2",
    "prisma": "^7.10.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
