{
  "name": "comgen",
  "private": true,
  "version": "0.1.0",
  "description": "Génération de communications inter-organisations, vérifiées fait par fait, approuvées par des humains.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @comgen/web dev",
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "test": "pnpm -r --no-bail test",
    "test:e2e": "pnpm --filter @comgen/web test:e2e",
    "check:contrast": "pnpm --filter @comgen/web check:contrast",
    "storybook": "pnpm --filter @comgen/web storybook",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm check:contrast",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "oxlint": "^1.85.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.2"
  }
}
