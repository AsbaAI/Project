# ComGen — configuration d'exécution (apps/web et packages/*)
# Copier en `.env` à la racine (jamais versionné). Aucun secret dans le code.

# PostgreSQL 16
DATABASE_URL=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_dev
# Base des tests d'intégration (packages/db, e2e)
DATABASE_URL_TEST=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_test

# Redis 7 (files BullMQ, lot 3)
REDIS_URL=redis://127.0.0.1:6379

# Authentification (Auth.js). Secret : `openssl rand -base64 32`
AUTH_SECRET=remplacez-moi-par-32-caracteres-aleatoires-au-moins
AUTH_URL=http://localhost:3000
# Fournisseur OIDC générique (les trois ensemble). Vide en développement.
# AUTH_OIDC_ISSUER=https://login.exemple.test/realms/comgen
# AUTH_OIDC_CLIENT_ID=comgen
# AUTH_OIDC_CLIENT_SECRET=
# Connexion simulée : choix d'un utilisateur du jeu de démonstration. Refusée en production.
AUTH_SIMULATEUR=true

# Dépôt de fichiers : `fichiers` (racine locale) ou `s3` (compatible S3, MinIO en local)
STOCKAGE_TYPE=fichiers
# STOCKAGE_RACINE=.local/stockage
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=eu-west-1
# S3_BUCKET=comgen
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Antivirus des fichiers déposés : `clamd` (démon ClamAV) ou, EXPLICITEMENT, `aucun`.
# Pas de valeur par défaut : le choix est affiché à l'utilisateur.
ANTIVIRUS_MODE=aucun
# CLAMD_HOTE=127.0.0.1
# CLAMD_PORT=3310
