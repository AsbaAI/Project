# ComGen — configuration d'exécution (apps/web et packages/*)
# Copier en `.env` à la racine (jamais versionné). Aucun secret dans le code.

# PostgreSQL 16
DATABASE_URL=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_dev
# Bases des tests, une par suite (chacune est vidée par ses tests) :
#   packages/db → comgen_test ; services de apps/web → comgen_test_web ;
#   Playwright → comgen_e2e (remise au jeu de démonstration à chaque passe).
DATABASE_URL_TEST=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_test
# DATABASE_URL_TEST_WEB=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_test_web
# DATABASE_URL_E2E=postgresql://comgen:comgen_dev@127.0.0.1:5432/comgen_e2e

# Redis 7 (files BullMQ, lot 3)
REDIS_URL=redis://127.0.0.1:6379

# Authentification (Auth.js). Secret : `openssl rand -base64 32`
AUTH_SECRET=remplacez-moi-par-32-caracteres-aleatoires-au-moins
AUTH_URL=http://localhost:3000
# Fournisseur OIDC générique (les trois ensemble). Vide en développement.
# AUTH_OIDC_ISSUER=https://login.exemple.test/realms/comgen
# AUTH_OIDC_CLIENT_ID=comgen
# AUTH_OIDC_CLIENT_SECRET=
# Connexion simulée : choix d'un utilisateur du jeu de démonstration. Refusée en production.
AUTH_SIMULATEUR=true
# Environnement de déploiement : developpement | test | demo | production. Par défaut,
# un build de production (`next start`) est la production ; les tests de bout en bout
# le déclarent `test` pour utiliser le simulateur. `demo` : démonstration publique,
# bandeau visible, simulateur admis (voir docs/DEPLOIEMENT.md).
# COMGEN_ENV=developpement
# Échelonne les agents simulés (1 à 3 s chacun) pour qu'on les voie travailler.
# Actif par défaut : c'est le comportement de la démonstration. `false` les
# rend instantanés (tests, CI).
# COMGEN_DELAIS_SIMULATION=true
# Neon (Vercel) : URL directe, prise par les migrations quand elle est posée.
# DATABASE_URL_UNPOOLED=

# Dépôt de fichiers : `fichiers` (racine locale) ou `s3` (compatible S3, MinIO en local)
STOCKAGE_TYPE=fichiers
# STOCKAGE_RACINE=.local/stockage
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=eu-west-1
# S3_BUCKET=comgen
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

# Antivirus des fichiers déposés : `clamd` (démon ClamAV) ou, EXPLICITEMENT, `aucun`.
# Pas de valeur par défaut : le choix est affiché à l'utilisateur.
ANTIVIRUS_MODE=aucun
# CLAMD_HOTE=127.0.0.1
# CLAMD_PORT=3310

# ---------------------------------------------------------------------------
# Connecteur ITSM (ServiceNow)
# ---------------------------------------------------------------------------
# Mode du connecteur : servicenow (défaut) | mock | desactive
#   servicenow : chaque organisation configure son instance dans l'écran
#                Paramètres > Connecteur ITSM ; la liste ci-dessous borne les
#                adresses acceptées.
#   mock       : tickets fictifs engendrés localement (démonstration, tests
#                de bout en bout). Aucune instance n'est jointe.
#   desactive  : la source ITSM disparaît de toute l'application.
# ITSM_MODE=servicenow
# Hôtes autorisés EN PLUS de `.service-now.com`, séparés par des virgules.
# Une entrée qui commence par un point est un suffixe de domaine. L'adresse
# d'instance saisie dans l'écran doit s'y conformer : c'est ce qui empêche
# un administrateur de faire parler le serveur à un hôte interne (SSRF).
# ITSM_HOTES_AUTORISES=itsm.entreprise.example,.service-now.eu
#
# Le secret du connecteur n'est JAMAIS saisi dans l'interface ni rangé en
# base : l'écran enregistre le NOM d'une variable ci-dessous, le serveur la
# résout au moment de l'appel. Le nom doit commencer par `ITSM_` (contrainte
# vérifiée en base), si bien qu'aucune autre variable n'est atteignable.
#   OAuth 2.0 : secret client ; Basic : mot de passe du compte de service.
# ITSM_SERVICENOW_SECRET=

# Chromium imposé pour Playwright, quand la machine en fournit un hors de
# l'arbre de Playwright (conteneur préinstallé). Laisser vide sinon.
# PLAYWRIGHT_CHROMIUM_PATH=/opt/pw-browsers/chromium
